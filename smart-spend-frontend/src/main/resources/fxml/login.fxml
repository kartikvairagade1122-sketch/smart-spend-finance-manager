<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartspend.client.controller.LoginController"
      style="-fx-background-color: #0b1120;" prefHeight="760.0" prefWidth="1200.0">

    <!-- LEFT BRAND SHOWCASE PANEL -->
    <VBox alignment="CENTER_LEFT" spacing="24" prefWidth="480"
          style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a); -fx-padding: 60;">
        <ImageView fx:id="brandLogo" fitHeight="70" preserveRatio="true"/>

        <VBox spacing="8">
            <Label text="Smart Spend" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            <Label text="Multi-User Personal Finance Management System"
                   style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #38bdf8;" wrapText="true"/>
            <Label text="Track your money in Indian Rupees (₹). Secure, multi-user isolated, enterprise personal accounting."
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;" wrapText="true"/>
        </VBox>

        <VBox spacing="14" style="-fx-padding: 20 0 0 0;">
            <Label text="✓  Strict Multi-User Data Isolation (Zero Data Leakage)"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            <Label text="✓  BCrypt Hashing &amp; Dual-Token JWT Security"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            <Label text="✓  Real-Time Income, Expense &amp; Monthly Budget Tracking"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            <Label text="✓  Accurate Decimal Calculations in Indian Rupees (₹)"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            <Label text="✓  One-Click CSV Export for Financial Reports"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px; -fx-font-weight: 600;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <Label text="v1.0.0 Production Architecture • Spring Boot 3 + JavaFX"
               style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
    </VBox>

    <!-- RIGHT LOGIN / REGISTRATION CARD -->
    <StackPane HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-padding: 40;">
        <VBox alignment="CENTER" maxWidth="460" spacing="18"
              style="-fx-background-color: #1e293b; -fx-background-radius: 24; -fx-padding: 40; -fx-border-color: #334155; -fx-border-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 25, 0, 0, 8);">

            <!-- TOGGLE TABS (LOGIN / REGISTER) -->
            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #0f172a; -fx-background-radius: 12; -fx-padding: 6;">
                <Button fx:id="tabLoginBtn" text="Sign In" onAction="#handleShowLogin" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"/>
                <Button fx:id="tabRegisterBtn" text="Create Account" onAction="#handleShowRegister" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        styleClass="nav-button"/>
            </HBox>

            <!-- FORM HEADER -->
            <VBox spacing="4" alignment="CENTER_LEFT" maxWidth="Infinity">
                <Label fx:id="formTitle" text="Welcome Back"
                       style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                <Label fx:id="formSubtitle" text="Enter your credentials to access your financial dashboard"
                       style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- STATUS / ERROR BANNER -->
            <Label fx:id="messageLabel" text="" visible="false" managed="false" wrapText="true"
                   style="-fx-background-color: rgba(239, 68, 68, 0.15); -fx-text-fill: #f87171; -fx-padding: 10 14; -fx-background-radius: 10; -fx-font-size: 12px; -fx-font-weight: 600;"/>

            <!-- REGISTRATION ONLY: FULL NAME -->
            <VBox fx:id="nameBox" spacing="6" visible="false" managed="false" maxWidth="Infinity">
                <Label text="Full Name" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="nameField" promptText="e.g. Kartik Vairagade" styleClass="custom-input"/>
            </VBox>

            <!-- REGISTRATION ONLY: EMAIL -->
            <VBox fx:id="emailBox" spacing="6" visible="false" managed="false" maxWidth="Infinity">
                <Label text="Email Address" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="emailField" promptText="name@example.com" styleClass="custom-input"/>
            </VBox>

            <!-- USERNAME / EMAIL (FOR LOGIN) OR USERNAME (FOR REGISTER) -->
            <VBox spacing="6" maxWidth="Infinity">
                <Label fx:id="usernameLabel" text="Username or Email" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="usernameField" promptText="Enter your username or email" styleClass="custom-input"/>
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="6" maxWidth="Infinity">
                <Label text="Password" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="custom-input"/>
            </VBox>

            <!-- REGISTRATION ONLY: CONFIRM PASSWORD -->
            <VBox fx:id="confirmPasswordBox" spacing="6" visible="false" managed="false" maxWidth="Infinity">
                <Label text="Confirm Password" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="custom-input"/>
            </VBox>

            <!-- SUBMIT BUTTON -->
            <Button fx:id="submitBtn" text="Sign In to Smart Spend" onAction="#handleSubmit"
                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 12;"/>

            <!-- PROGRESS INDICATOR -->
            <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" maxHeight="30" maxWidth="30"/>
        </VBox>
    </StackPane>
</HBox>
