<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartspend.client.controller.BudgetsController"
      spacing="20" style="-fx-padding: 10 20 20 20;" VBox.vgrow="ALWAYS">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Monthly Budget Management" styleClass="page-header-title"/>
            <Label text="Monitor category spending caps with automated alerts in Indian Rupees (₹)" styleClass="page-header-subtitle"/>
        </VBox>

        <ComboBox fx:id="monthBox" prefWidth="130" styleClass="custom-combo-box"/>
        <ComboBox fx:id="yearBox" prefWidth="100" styleClass="custom-combo-box"/>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-secondary"/>
        <Button text="➕ Set Budget" onAction="#handleNewBudget" styleClass="btn-primary"/>
    </HBox>

    <!-- BUDGET METRICS OVERVIEW -->
    <HBox spacing="18" styleClass="kpi-card" style="-fx-padding: 18 24;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="TOTAL BUDGETED LIMIT" styleClass="kpi-title"/>
            <Label fx:id="totalBudgetedLabel" text="₹0.00" styleClass="kpi-value-balance"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="TOTAL ACTUAL SPENT" styleClass="kpi-title"/>
            <Label fx:id="totalSpentLabel" text="₹0.00" styleClass="kpi-value-expense"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="OVERALL REMAINING" styleClass="kpi-title"/>
            <Label fx:id="totalRemainingLabel" text="₹0.00" styleClass="kpi-value-income"/>
        </VBox>
    </HBox>

    <!-- BUDGET CARDS SCROLLABLE CONTAINER -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="budgetCardsList" spacing="16" style="-fx-padding: 8 0;"/>
    </ScrollPane>
</VBox>
