<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartspend.client.controller.ReportsController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="22" style="-fx-padding: 10 20 40 20;">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Financial Reports &amp; Analytics" styleClass="page-header-title"/>
                <Label text="Audit daily, weekly, monthly and yearly cash flow metrics with CSV exports in Indian Rupees (₹)" styleClass="page-header-subtitle"/>
            </VBox>
            <Button text="📥  Export to CSV" onAction="#handleExportCsv" styleClass="btn-success" style="-fx-font-size: 13px; -fx-padding: 10 18;"/>
        </HBox>

        <!-- PERIOD FILTER TOOLBAR -->
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="kpi-card" style="-fx-padding: 14 20;">
            <Label text="Period:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700;"/>

            <HBox spacing="6">
                <ToggleButton fx:id="btnDaily" text="Daily" onAction="#handlePeriodSelect" styleClass="btn-secondary"/>
                <ToggleButton fx:id="btnWeekly" text="Weekly" onAction="#handlePeriodSelect" styleClass="btn-secondary"/>
                <ToggleButton fx:id="btnMonthly" text="Monthly" selected="true" onAction="#handlePeriodSelect" styleClass="btn-secondary"/>
                <ToggleButton fx:id="btnYearly" text="Yearly" onAction="#handlePeriodSelect" styleClass="btn-secondary"/>
            </HBox>

            <Separator orientation="VERTICAL"/>

            <Label text="Custom:" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <DatePicker fx:id="customStartDate" promptText="Start Date" prefWidth="130" styleClass="date-picker"/>
            <DatePicker fx:id="customEndDate" promptText="End Date" prefWidth="130" styleClass="date-picker"/>
            <Button text="Apply Custom Range" onAction="#handleApplyCustomRange" styleClass="btn-primary"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="periodLabel" text="Report for Current Month" style="-fx-text-fill: #38bdf8; -fx-font-weight: 700;"/>
        </HBox>

        <!-- KPI SUMMARY ROW -->
        <GridPane hgap="18" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox spacing="6" styleClass="kpi-card" GridPane.columnIndex="0">
                <Label text="PERIOD INCOME" styleClass="kpi-title"/>
                <Label fx:id="repTotalIncome" text="₹0.00" styleClass="kpi-value-income"/>
                <Label text="Total credited" styleClass="kpi-subtext"/>
            </VBox>

            <VBox spacing="6" styleClass="kpi-card" GridPane.columnIndex="1">
                <Label text="PERIOD EXPENSES" styleClass="kpi-title"/>
                <Label fx:id="repTotalExpenses" text="₹0.00" styleClass="kpi-value-expense"/>
                <Label text="Total debited" styleClass="kpi-subtext"/>
            </VBox>

            <VBox spacing="6" styleClass="kpi-card" GridPane.columnIndex="2">
                <Label text="NET SAVINGS" styleClass="kpi-title"/>
                <Label fx:id="repNetSavings" text="₹0.00" styleClass="kpi-value-balance"/>
                <Label text="Income − Expenses" styleClass="kpi-subtext"/>
            </VBox>

            <VBox spacing="6" styleClass="kpi-card" GridPane.columnIndex="3">
                <Label text="SAVINGS RATE" styleClass="kpi-title"/>
                <Label fx:id="repSavingsRate" text="0.0%" styleClass="kpi-value-savings"/>
                <Label fx:id="repTxCount" text="0 transactions recorded" styleClass="kpi-subtext"/>
            </VBox>
        </GridPane>

        <!-- CATEGORY ANALYSIS & PIE CHART -->
        <HBox spacing="20">
            <!-- BREAKDOWN TABLE -->
            <VBox spacing="10" styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="600">
                <Label text="Category Expense Breakdown" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700;"/>
                <TableView fx:id="categoryTable" prefHeight="260" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colCatName" text="Category" prefWidth="240"/>
                        <TableColumn fx:id="colCatAmount" text="Spent Amount (INR)" prefWidth="160"/>
                        <TableColumn fx:id="colCatPercent" text="Percentage" prefWidth="120"/>
                        <TableColumn fx:id="colCatTxCount" text="Count" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- PIE CHART -->
            <VBox spacing="10" styleClass="kpi-card" prefWidth="480">
                <Label text="Visual Spending Distribution" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700;"/>
                <PieChart fx:id="reportPieChart" styleClass="chart" VBox.vgrow="ALWAYS" legendVisible="true"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
