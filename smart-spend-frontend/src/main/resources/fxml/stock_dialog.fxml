<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartspend.client.controller.StockDialogController"
            prefWidth="520.0" prefHeight="620.0"
            stylesheets="@../css/theme.css"
            style="-fx-background-color: #0f172a;">

    <!-- TOP: Fixed Dialog Header -->
    <top>
        <VBox spacing="6.0" style="-fx-padding: 24 24 18 24; -fx-background-color: #0f172a; -fx-border-color: #1e293b; -fx-border-width: 0 0 1 0;">
            <Label fx:id="dialogTitle" text="Add Stock Investment"
                   style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: white;"/>
            <Label text="Track Indian NSE/BSE equities with real-time market valuations in Indian Rupees (₹)."
                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" wrapText="true"/>
        </VBox>
    </top>

    <!-- CENTER: Scrollable Form Content -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="16.0" style="-fx-padding: 20 24; -fx-background-color: #0f172a;">

                <!-- Error Alert Banner -->
                <Label fx:id="errorLabel" visible="false" managed="false"
                       style="-fx-background-color: rgba(239, 68, 68, 0.15); -fx-text-fill: #f87171; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: rgba(239, 68, 68, 0.4); -fx-border-radius: 8; -fx-font-size: 12px; -fx-font-weight: 600;"
                       wrapText="true"/>

                <!-- Stock Symbol & Live Quote Lookup -->
                <VBox spacing="6.0">
                    <Label text="Stock Symbol (NSE / BSE)" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <TextField fx:id="symbolField" promptText="e.g. RELIANCE, TCS, INFY, TATAMOTORS, HDFCBANK"
                                   styleClass="input-field" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="fetchQuoteBtn" text="🔍 Live Price" onAction="#handleFetchQuote"
                                styleClass="btn-secondary" style="-fx-padding: 9 16; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Note: Auto-appends '.NS' for National Stock Exchange if omitted."
                           style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </VBox>

                <!-- Live Quote Banner (Auto-populated on verified live price) -->
                <HBox fx:id="quoteBanner" visible="false" managed="false" alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: rgba(16, 185, 129, 0.12); -fx-border-color: rgba(16, 185, 129, 0.35); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16;">
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0">
                        <Label fx:id="bannerCompanyName" text="Company Name" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 13px;"/>
                        <Label fx:id="bannerExchange" text="NSE India" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                        <Label fx:id="bannerLivePrice" text="₹0.00" style="-fx-font-weight: 800; -fx-text-fill: #34d399; -fx-font-size: 16px;"/>
                        <Label fx:id="bannerDayChange" text="+0.00%" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
                    </VBox>
                </HBox>

                <!-- Company Name Field -->
                <VBox spacing="6.0">
                    <Label text="Company Name" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <TextField fx:id="companyNameField" promptText="e.g. Reliance Industries Limited"
                               styleClass="input-field"/>
                </VBox>

                <!-- Quantity & Buy Price in 2 Columns -->
                <HBox spacing="16.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Number of Shares (Qty)" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                        <TextField fx:id="quantityField" promptText="e.g. 10"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Buy Price per Share (₹)" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                        <TextField fx:id="buyPriceField" promptText="e.g. 1250.00"
                                   styleClass="input-field"/>
                    </VBox>
                </HBox>

                <!-- Purchase Date -->
                <VBox spacing="6.0">
                    <Label text="Purchase Date" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                    <DatePicker fx:id="buyDatePicker" maxWidth="Infinity" styleClass="input-field"/>
                </VBox>

                <!-- Total Investment Preview -->
                <HBox alignment="CENTER_LEFT" spacing="8.0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8;">
                    <Label text="Calculated Total Invested:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <Label fx:id="totalInvestedPreview" text="₹0.00" style="-fx-text-fill: #38bdf8; -fx-font-weight: 800; -fx-font-size: 15px;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- BOTTOM: Pinned Action Buttons Bar (Always Visible, Never Cut Off) -->
    <bottom>
        <HBox spacing="12.0" alignment="CENTER_RIGHT"
              style="-fx-background-color: #0b1120; -fx-padding: 16 24; -fx-border-color: #1e293b; -fx-border-width: 1 0 0 0;">
            <Button text="Cancel" onAction="#handleCancel"
                    styleClass="btn-secondary" style="-fx-padding: 10 20; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            <Button fx:id="saveButton" text="💾 Save to Portfolio" onAction="#handleSave"
                    styleClass="btn-primary" style="-fx-padding: 10 24; -fx-font-size: 13px; -fx-font-weight: 700;"/>
        </HBox>
    </bottom>

</BorderPane>
